{
  "name": "notes-agent-workbench",
  "productName": "Plate 本机试用版",
  "version": "0.2.0-r4cv.1",
  "private": true,
  "description": "Local notes and Agent workspace",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win --dir --config.directories.output=release/m1.2",
    "test:notes": "npm run build && node acceptance/m1.2.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "better-sqlite3": "^13.1.1",
    "chokidar": "^6.0.0",
    "dompurify": "^3.4.17",
    "framer-motion": "12.43.0",
    "markdown-it": "^15.0.3",
    "react": "^19",
    "react-dom": "^19",
    "yaml": "^2.9.1",
    "zustand": "^5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "electron": "^44",
    "electron-builder": "^26",
    "electron-vite": "^5",
    "playwright": "^1.65.0",
    "typescript": "~5.9",
    "vite": "^7"
  },
  "build": {
    "appId": "local.plate.r4cv.preview",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "executableName": "Plate-R4CV-Preview"
    },
    "extraResources": [
      {"from":"native/managed.node","to":"managed.node"},
      {"from":"native/firstrun-directory.node","to":"firstrun-directory.node"},
      {"from":"native/m45-terminal.node","to":"m45-terminal.node"},
      {"from":"native/CodexDesktopBroker.exe","to":"m45-desktop/CodexDesktopBroker.exe"}
    ],
    "asarUnpack": ["out/main/native/**"],
    "npmRebuild": false
  }
}
