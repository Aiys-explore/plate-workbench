{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plate Workbench",
  "version": "0.3.0-s6.0",
  "identifier": "local.plate.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Plate — 笔记 + Agent 工作台",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
