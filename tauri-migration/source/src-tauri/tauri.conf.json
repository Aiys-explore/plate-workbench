{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plate Workbench S7 Preview",
  "version": "0.3.0-s7.1",
  "identifier": "local.plate.workbench.s7-preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Plate S7 — 本机试用版",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
