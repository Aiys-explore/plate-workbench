{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plate Workbench S9 Preview",
  "version": "0.5.0-s9.6",
  "identifier": "local.plate.workbench.s7-preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "[plate] — 本机试用版",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFQTczQ0ZCM0NGNkY0RkYKUldULzlQWTgrenluWGpLNzNMSjBlbWNUS0gyck5CbXEvTzlHdzB0Qmp5Z0VFQkxDUW9DTzF6RUUK",
      "endpoints": [
        "https://raw.githubusercontent.com/fundops-notes/plate-workbench/checkpoint/tauri-s9/tauri-migration/updates/windows-x64.json"
      ],
      "requireSignedVersion": true
    }
  }
}
